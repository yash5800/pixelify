{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "installCommand": "ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm install --no-audit --no-fund",
  "fluid": true,
  "functions": {
    "api/bg-remove.js": {
      "memory": 2048,
      "maxDuration": 300,
      "includeFiles": [
        "node_modules/onnxruntime-node/bin/napi-v3/linux/x64/**"
      ]
    },
    "api/health.js": {
      "memory": 2048,
      "maxDuration": 300,
      "includeFiles": [
        "node_modules/onnxruntime-node/bin/napi-v3/linux/x64/**"
      ]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/upscaler/:path*",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/bg_remove/:path*",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ]
}
